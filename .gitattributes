# Preserve PDF streams and cross-reference byte offsets on every platform.
*.pdf binary

# Preserve the content-hashed bench-holder deliverables on Windows checkouts.
manufacturing/bench-holder/** -text
mechanical/bench-holder/** -text
docs/verification/bench-holder/** -text whitespace=cr-at-eol
docs/bench-holder-guide.md -text
tools/*bench-holder*.py -text
# STEP is generated by native CAD; regenerate instead of text-merging it.
manufacturing/bench-holder/*.step binary

# Keep the newer content-hashed print packages and evidence byte-exact too.
manufacturing/bench-panel-b2/** -text
manufacturing/ec11-flange-nut/** -text
manufacturing/enclosure-c1/** -text
mechanical/enclosure/c1/** -text
docs/verification/bench-panel-b2/** -text
docs/verification/ec11-flange-nut/** -text
docs/verification/enclosure-c1/** -text
docs/bench-panel-b2-guide.md -text
docs/ec11-flange-nut-guide.md -text
docs/enclosure-c1-guide.md -text
docs/reference/ic229h-mounting.md -text

# Preserve each hashed generator's recorded bytes on Windows checkouts.
tools/*enclosure-c1.py -text
tools/*bench-panel.py -text
tools/*ec11*.py -text
tools/prepare-enclosure-plates.py -text

# Generated native exchange/plot snapshots are regenerated rather than merged.
manufacturing/bench-panel-b2/*.step binary
manufacturing/ec11-flange-nut/*.step binary
manufacturing/enclosure-c1/supporting/step/*.step binary
docs/images/populated-board-learning/*.svg binary
